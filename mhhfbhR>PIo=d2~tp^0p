<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>拼图海报智能生成器</title>
  <!-- 调用根目录下的 favicon.png -->
  <link rel="icon" type="image/png" href="./favicon.png">
  
  <style>
    body { 
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; 
      background: #f0f2f5; 
      margin: 0; 
      padding: 20px; 
      display: flex; 
      gap: 20px; 
      height: 100vh; 
      box-sizing: border-box; 
    }
    .control-panel { 
      flex: 1; 
      background: white; 
      padding: 25px; 
      border-radius: 12px; 
      box-shadow: 0 4px 20px rgba(0,0,0,0.08); 
      display: flex; 
      flex-direction: column; 
      gap: 18px; 
      min-width: 300px;
      max-width: 380px; 
      overflow-y: auto; 
    }
    .preview-panel { 
      flex: 2; 
      display: flex; 
      flex-direction: column; 
      align-items: center; 
      justify-content: center; 
      background: #e9ecef; 
      border-radius: 12px; 
      overflow: auto; 
      padding: 20px; 
      box-shadow: inset 0 4px 12px rgba(0,0,0,0.05); 
    }
    h2 { margin-top: 0; font-size: 22px; color: #1a1a1a; display: flex; align-items: center; gap: 8px;}
    label { font-weight: 600; font-size: 14px; color: #444; display: flex; justify-content: space-between;}
    textarea { 
      width: 100%; height: 120px; padding: 12px; border: 1px solid #d1d5db; 
      border-radius: 8px; resize: vertical; box-sizing: border-box; font-family: inherit;
    }
    textarea:focus { outline: none; border-color: #007bff; box-shadow: 0 0 0 3px rgba(0,123,255,0.1); }
    input[type="color"] { border: none; width: 100%; height: 44px; border-radius: 8px; cursor: pointer; padding: 0; }
    input[type="color"]::-webkit-color-swatch-wrapper { padding: 0; }
    input[type="color"]::-webkit-color-swatch { border: none; border-radius: 8px; }
    input[type="range"] { width: 100%; cursor: pointer; margin-top: 8px;}
    
    .paste-area { 
      border: 2px dashed #007bff; border-radius: 8px; padding: 30px 20px; 
      text-align: center; color: #007bff; background: #f8fbff; cursor: pointer; 
      transition: all 0.3s ease; font-size: 15px; line-height: 1.5;
    }
    .paste-area:hover { background: #e6f2ff; border-color: #0056b3; }
    .paste-area b { color: #0056b3; font-size: 18px;}
    
    .btn-group { display: flex; gap: 10px; margin-top: 10px; }
    button { 
      flex: 1; border: none; padding: 14px; font-size: 15px; border-radius: 8px; 
      cursor: pointer; transition: 0.2s; font-weight: bold; color: white;
    }
    button:active { transform: scale(0.98); }
    button.copy-btn { background: #10b981; } /* 绿色 */
    button.copy-btn:hover { background: #059669; }
    button.download-btn { background: #3b82f6; } /* 蓝色 */
    button.download-btn:hover { background: #2563eb; }
    
    canvas { 
      max-width: 100%; max-height: 100%; object-fit: contain;
      box-shadow: 0 10px 30px rgba(0,0,0,0.15); transition: 0.3s; 
    }
    
    /* 响应式：手机端变成上下布局 */
    @media (max-width: 768px) {
      body { flex-direction: column; height: auto; }
      .control-panel { max-width: 100%; }
      .preview-panel { min-height: 500px; }
    }
  </style>
</head>
<body>

  <!-- 左侧控制面板 -->
  <div class="control-panel">
    <h2>✨ 海报排版控制台</h2>
    
    <div class="paste-area" id="pasteArea">
      点击此处后，直接按 <b>Ctrl + V</b><br>粘贴截图或网页图片<br>
      <span style="font-size: 12px; color: #666;">(也可点击选择本地图片)</span>
      <input type="file" id="fileInput" accept="image/*" style="display:none">
    </div>

    <div>
      <label>输入文案 (实时渲染)：</label>
      <textarea id="textInput" placeholder="在此粘贴文案..."></textarea>
    </div>

    <div>
      <label>背景底色：</label>
      <!-- 默认您的金黄色 -->
      <input type="color" id="bgColor" value="#FFD700">
    </div>

    <div>
      <label>文字大小：<span id="fontSizeVal">32px</span></label>
      <input type="range" id="fontSize" min="12" max="100" value="32">
    </div>

    <div>
      <label>画布留白 (Padding)：<span id="paddingVal">40px</span></label>
      <input type="range" id="padding" min="0" max="150" value="40">
    </div>

    <div class="btn-group">
      <button class="copy-btn" id="copyBtn">📋 一键复制</button>
      <button class="download-btn" id="downloadBtn">📥 保存图片</button>
    </div>
  </div>

  <!-- 右侧预览面板 -->
  <div class="preview-panel">
    <canvas id="posterCanvas"></canvas>
  </div>

  <script>
    const canvas = document.getElementById('posterCanvas');
    const ctx = canvas.getContext('2d');
    let currentImage = null;

    const textInput = document.getElementById('textInput');
    const bgColorInput = document.getElementById('bgColor');
    const fontSizeInput = document.getElementById('fontSize');
    const paddingInput = document.getElementById('padding');
    const pasteArea = document.getElementById('pasteArea');
    const fileInput = document.getElementById('fileInput');

    // 绑定实时更新事件
    [textInput, bgColorInput, fontSizeInput, paddingInput].forEach(el => {
      el.addEventListener('input', drawPoster);
    });

    // 监听全避局 Ctrl+V 粘贴事件
    document.addEventListener('paste', function(e) {
      const items = (e.clipboardData || e.originalEvent.clipboardData).items;
      for (let i = 0; i < items.length; i++) {
        if (items[i].type.indexOf('image') !== -1) {
          const blob = items[i].getAsFile();
          loadImageBlob(blob);
          e.preventDefault();
          return;
        }
      }
    });

    // 点击上传文件
    pasteArea.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', (e) => {
      if (e.target.files && e.target.files[0]) loadImageBlob(e.target.files[0]);
    });

    function loadImageBlob(blob) {
      const reader = new FileReader();
      reader.onload = function(event) {
        const img = new Image();
        img.onload = function() {
          currentImage = img;
          drawPoster();
        }
        img.src = event.target.result;
      }
      reader.readAsDataURL(blob);
    }

    // 绘制海报核心算法
    function drawPoster() {
      if (!currentImage) {
        // 如果没有图片，画一个初始提示画面
        canvas.width = 600; canvas.height = 400;
        ctx.fillStyle = "#ffffff"; ctx.fillRect(0, 0, 600, 400);
        ctx.fillStyle = "#cccccc"; ctx.font = "24px sans-serif"; ctx.textAlign = "center";
        ctx.fillText("等待载入图片...", 300, 200);
        return;
      }

      // 更新滑块数值显示
      document.getElementById('fontSizeVal').innerText = fontSizeInput.value + 'px';
      document.getElementById('paddingVal').innerText = paddingInput.value + 'px';

      const text = textInput.value;
      const bgColor = bgColorInput.value;
      const fontSize = parseInt(fontSizeInput.value);
      const padding = parseInt(paddingInput.value);
      
      const imgW = currentImage.width;
      const imgH = currentImage.height;
      const imgRatio = imgW / imgH;

      ctx.font = `${fontSize}px -apple-system, 'Segoe UI', Arial, sans-serif`;
      const lineHeight = fontSize * 1.6;
      
      let canvasW, canvasH, textMaxWidth;

      // 智能判断排版：宽图采用“上图下文”，高图采用“左图右文”
      if (imgRatio >= 0.9) { 
        // 【模式一：上图下文】
        canvasW = imgW + padding * 2;
        textMaxWidth = imgW; 
        const textLines = wrapText(ctx, text, textMaxWidth);
        const textHeight = textLines.length > 0 ? (textLines.length * lineHeight) : 0;
        
        canvasH = imgH + textHeight + padding * (textLines.length > 0 ? 3 : 2);
        
        canvas.width = canvasW; canvas.height = canvasH;
        ctx.fillStyle = bgColor; ctx.fillRect(0, 0, canvasW, canvasH);
        
        ctx.drawImage(currentImage, padding, padding, imgW, imgH);
        
        ctx.fillStyle = "#000000";
        ctx.font = `${fontSize}px -apple-system, 'Segoe UI', Arial, sans-serif`;
        ctx.textAlign = "center";
        ctx.textBaseline = "top";
        
        textLines.forEach((line, index) => {
          ctx.fillText(line, canvasW / 2, padding * 2 + imgH + index * lineHeight);
        });

      } else {
        // 【模式二：左图右文】
        textMaxWidth = Math.max(imgW * 0.6, fontSize * 10); // 根据图片宽度动态给文字区空间
        const textLines = wrapText(ctx, text, textMaxWidth);
        const totalTextHeight = textLines.length * lineHeight;
        
        canvasW = imgW + textMaxWidth + padding * 3;
        canvasH = Math.max(imgH + padding * 2, totalTextHeight + padding * 2);

        canvas.width = canvasW; canvas.height = canvasH;
        ctx.fillStyle = bgColor; ctx.fillRect(0, 0, canvasW, canvasH);

        const finalImgY = (canvasH - imgH) / 2;
        ctx.drawImage(currentImage, padding, finalImgY, imgW, imgH);

        ctx.fillStyle = "#000000";
        ctx.font = `${fontSize}px -apple-system, 'Segoe UI', Arial, sans-serif`;
        ctx.textAlign = "left";
        ctx.textBaseline = "top";
        
        const startTextY = (canvasH - totalTextHeight) / 2;
        
        textLines.forEach((line, index) => {
          ctx.fillText(line, padding * 2 + imgW, startTextY + index * lineHeight);
        });
      }
    }

    // 中英文混合智能换行
    function wrapText(context, text, maxWidth) {
      if (!text.trim()) return [];
      const lines = [];
      const chars = text.split('');
      let currentLine = '';

      for (let i = 0; i < chars.length; i++) {
        let testLine = currentLine + chars[i];
        let metrics = context.measureText(testLine);
        if (metrics.width > maxWidth && i > 0) {
          if (chars[i] === '\n') {
            lines.push(currentLine); currentLine = '';
          } else {
            lines.push(currentLine); currentLine = chars[i];
          }
        } else {
          if (chars[i] === '\n') {
             lines.push(currentLine); currentLine = '';
          } else {
             currentLine = testLine;
          }
        }
      }
      if (currentLine) lines.push(currentLine);
      return lines;
    }

    // 初始化画板
    drawPoster();

    // 复制到剪贴板功能
    document.getElementById('copyBtn').addEventListener('click', () => {
      if (!currentImage) return alert("请先粘贴或选择一张图片！");
      try {
        canvas.toBlob(async (blob) => {
          const item = new ClipboardItem({ "image/png": blob });
          await navigator.clipboard.write([item]);
          
          const btn = document.getElementById('copyBtn');
          btn.innerText = "✅ 已复制到剪贴板";
          setTimeout(() => btn.innerText = "📋 一键复制", 2000);
        });
      } catch (err) {
        alert("浏览器不支持一键复制，请点击右侧'保存图片'。");
      }
    });

    // 下载图片功能
    document.getElementById('downloadBtn').addEventListener('click', () => {
      if (!currentImage) return alert("请先粘贴或选择一张图片！");
      const link = document.createElement('a');
      link.download = '黄金海报_' + new Date().getTime() + '.png';
      link.href = canvas.toDataURL('image/png');
      link.click();
    });
  </script>
</body>
</html>
