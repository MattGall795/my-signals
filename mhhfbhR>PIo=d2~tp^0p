<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Smart Poster Generator</title>
  <link rel="icon" type="image/png" href="./favicon.png">
  
  <style>
    body { 
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; 
      background: #f4f6f8; 
      margin: 0; 
      padding: 20px; 
      display: flex; 
      gap: 20px; 
      height: 100vh; 
      box-sizing: border-box; 
    }
    .control-panel { 
      flex: 1; 
      background: white; 
      padding: 25px; 
      border-radius: 12px; 
      box-shadow: 0 4px 20px rgba(0,0,0,0.08); 
      display: flex; 
      flex-direction: column; 
      gap: 16px; 
      min-width: 320px;
      max-width: 400px; 
      overflow-y: auto; 
    }
    .preview-panel { 
      flex: 2; 
      display: flex; 
      flex-direction: column; 
      align-items: center; 
      justify-content: center; 
      background: #e9ecef; 
      border-radius: 12px; 
      overflow: auto; 
      padding: 20px; 
      box-shadow: inset 0 4px 12px rgba(0,0,0,0.05); 
    }
    h2 { margin-top: 0; margin-bottom: 5px; font-size: 22px; color: #1a1a1a; display: flex; align-items: center; justify-content: space-between;}
    
    .reset-btn {
      font-size: 13px; padding: 6px 12px; background: #f1f3f5; color: #495057; 
      border: none; border-radius: 6px; cursor: pointer; transition: 0.2s; font-weight: 600;
    }
    .reset-btn:hover { background: #e2e6ea; color: #d32f2f; }

    label { font-weight: 600; font-size: 13px; color: #444; display: flex; justify-content: space-between; align-items: center;}
    
    textarea { 
      width: 100%; height: 100px; padding: 12px; border: 1px solid #d1d5db; 
      border-radius: 8px; resize: vertical; box-sizing: border-box; font-family: inherit; font-size: 14px;
    }
    textarea:focus { outline: none; border-color: #007bff; box-shadow: 0 0 0 3px rgba(0,123,255,0.1); }
    
    .color-group { display: flex; gap: 10px; }
    input[type="color"] { border: none; width: 100%; height: 40px; border-radius: 8px; cursor: pointer; padding: 0; }
    input[type="color"]::-webkit-color-swatch-wrapper { padding: 0; }
    input[type="color"]::-webkit-color-swatch { border: none; border-radius: 8px; }
    
    select, input[type="range"] { 
      width: 100%; padding: 8px; border-radius: 6px; border: 1px solid #d1d5db; 
      font-family: inherit; font-size: 14px; cursor: pointer;
    }
    input[type="range"] { padding: 0; border: none; margin-top: 8px;}
    
    .paste-area { 
      border: 2px dashed #007bff; border-radius: 8px; padding: 25px 20px; 
      text-align: center; color: #007bff; background: #f8fbff; cursor: pointer; 
      transition: all 0.3s ease; font-size: 14px; line-height: 1.5;
    }
    .paste-area:hover { background: #e6f2ff; border-color: #0056b3; }
    .paste-area b { color: #0056b3; font-size: 16px;}
    
    .btn-group { display: flex; gap: 10px; margin-top: 10px; }
    button.action-btn { 
      flex: 1; border: none; padding: 14px; font-size: 15px; border-radius: 8px; 
      cursor: pointer; transition: 0.2s; font-weight: bold; color: white; display: flex; justify-content: center; align-items: center; gap: 6px;
    }
    button.action-btn:active { transform: scale(0.98); }
    button.copy-btn { background: #10b981; } 
    button.copy-btn:hover { background: #059669; }
    button.download-btn { background: #3b82f6; } 
    button.download-btn:hover { background: #2563eb; }
    
    canvas { 
      max-width: 100%; max-height: 100%; object-fit: contain;
      box-shadow: 0 10px 30px rgba(0,0,0,0.15); transition: 0.3s; 
    }
    
    @media (max-width: 768px) {
      body { flex-direction: column; height: auto; }
      .control-panel { max-width: 100%; }
      .preview-panel { min-height: 500px; }
    }
  </style>
</head>
<body>

  <!-- Control Panel -->
  <div class="control-panel">
    <h2>
      Poster Studio
      <button class="reset-btn" id="resetBtn">🔄 Reset</button>
    </h2>
    
    <div class="paste-area" id="pasteArea">
      Click here & press <b>Ctrl + V</b><br>to paste an image<br>
      <span style="font-size: 12px; color: #666;">(or click to upload from device)</span>
      <input type="file" id="fileInput" accept="image/*" style="display:none">
    </div>

    <div>
      <label>Text Content (Live Preview):</label>
      <textarea id="textInput" placeholder="Paste your text here..."></textarea>
    </div>

    <div>
      <label>Background Gradient Colors:</label>
      <div class="color-group">
        <input type="color" id="color1" value="#FFD700" title="Top Color">
        <input type="color" id="color2" value="#FFA500" title="Bottom Color">
      </div>
    </div>

    <div>
      <label>Text Alignment:</label>
      <select id="textAlign">
        <option value="left">Left Align</option>
        <option value="center" selected>Center Align</option>
        <option value="right">Right Align</option>
      </select>
    </div>

    <div>
      <label>Font Size: <span id="fontSizeVal" style="color:#007bff;">32px</span></label>
      <input type="range" id="fontSize" min="12" max="100" value="32">
    </div>

    <div>
      <label>Canvas Padding: <span id="paddingVal" style="color:#007bff;">40px</span></label>
      <input type="range" id="padding" min="0" max="150" value="40">
    </div>

    <div class="btn-group">
      <button class="action-btn copy-btn" id="copyBtn">📋 Copy Image</button>
      <button class="action-btn download-btn" id="downloadBtn">📥 Download</button>
    </div>
  </div>

  <!-- Preview Panel -->
  <div class="preview-panel">
    <canvas id="posterCanvas"></canvas>
  </div>

  <script>
    const canvas = document.getElementById('posterCanvas');
    const ctx = canvas.getContext('2d');
    let currentImage = null;

    // DOM Elements
    const textInput = document.getElementById('textInput');
    const color1Input = document.getElementById('color1');
    const color2Input = document.getElementById('color2');
    const alignInput = document.getElementById('textAlign');
    const fontSizeInput = document.getElementById('fontSize');
    const paddingInput = document.getElementById('padding');
    const pasteArea = document.getElementById('pasteArea');
    const fileInput = document.getElementById('fileInput');
    const resetBtn = document.getElementById('resetBtn');

    // Bind real-time update events
    [textInput, color1Input, color2Input, alignInput, fontSizeInput, paddingInput].forEach(el => {
      el.addEventListener('input', drawPoster);
    });

    // Paste Image Event (Ctrl+V)
    document.addEventListener('paste', function(e) {
      const items = (e.clipboardData || e.originalEvent.clipboardData).items;
      for (let i = 0; i < items.length; i++) {
        if (items[i].type.indexOf('image') !== -1) {
          const blob = items[i].getAsFile();
          loadImageBlob(blob);
          e.preventDefault();
          return;
        }
      }
    });

    // Click to upload
    pasteArea.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', (e) => {
      if (e.target.files && e.target.files[0]) loadImageBlob(e.target.files[0]);
    });

    // Reset Application
    resetBtn.addEventListener('click', () => {
      currentImage = null;
      textInput.value = "";
      color1Input.value = "#FFD700";
      color2Input.value = "#FFA500";
      alignInput.value = "center";
      fontSizeInput.value = 32;
      paddingInput.value = 40;
      fileInput.value = "";
      drawPoster();
    });

    function loadImageBlob(blob) {
      const reader = new FileReader();
      reader.onload = function(event) {
        const img = new Image();
        img.onload = function() {
          currentImage = img;
          drawPoster();
        }
        img.src = event.target.result;
      }
      reader.readAsDataURL(blob);
    }

    // Core Drawing Algorithm
    function drawPoster() {
      // Update UI Slider Values
      document.getElementById('fontSizeVal').innerText = fontSizeInput.value + 'px';
      document.getElementById('paddingVal').innerText = paddingInput.value + 'px';

      if (!currentImage) {
        // Draw Empty State
        canvas.width = 600; canvas.height = 400;
        ctx.fillStyle = "#ffffff"; ctx.fillRect(0, 0, 600, 400);
        ctx.fillStyle = "#a0aab5"; ctx.font = "20px sans-serif"; ctx.textAlign = "center"; ctx.textBaseline = "middle";
        ctx.fillText("Please paste or select an image to preview", 300, 200);
        return;
      }

      const text = textInput.value;
      const color1 = color1Input.value;
      const color2 = color2Input.value;
      const align = alignInput.value;
      const fontSize = parseInt(fontSizeInput.value);
      const padding = parseInt(paddingInput.value);
      
      const imgW = currentImage.width;
      const imgH = currentImage.height;
      const imgRatio = imgW / imgH;

      ctx.font = `${fontSize}px -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif`;
      const lineHeight = fontSize * 1.5;
      
      let canvasW, canvasH, textMaxWidth;

      // Layout Logic: Top-Bottom for Wide/Square images, Left-Right for Tall images
      const isHorizontal = imgRatio >= 0.9; 

      if (isHorizontal) { 
        // --- MODE 1: Top Image, Bottom Text ---
        canvasW = imgW + padding * 2;
        textMaxWidth = imgW; 
        const textLines = wrapText(ctx, text, textMaxWidth);
        const textHeight = textLines.length > 0 ? (textLines.length * lineHeight) : 0;
        
        canvasH = imgH + textHeight + padding * (textLines.length > 0 ? 3 : 2);
        canvas.width = canvasW; canvas.height = canvasH;
        
        // Draw Gradient Background
        const gradient = ctx.createLinearGradient(0, 0, 0, canvasH);
        gradient.addColorStop(0, color1);
        gradient.addColorStop(1, color2);
        ctx.fillStyle = gradient; 
        ctx.fillRect(0, 0, canvasW, canvasH);
        
        // Draw Image
        ctx.drawImage(currentImage, padding, padding, imgW, imgH);
        
        // Draw Text
        ctx.fillStyle = "#000000";
        ctx.font = `${fontSize}px -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif`;
        ctx.textAlign = align;
        ctx.textBaseline = "top";
        
        let textX;
        if(align === "left") textX = padding;
        else if(align === "right") textX = canvasW - padding;
        else textX = canvasW / 2; // center

        textLines.forEach((line, index) => {
          ctx.fillText(line, textX, padding * 2 + imgH + index * lineHeight);
        });

      } else {
        // --- MODE 2: Left Image, Right Text ---
        textMaxWidth = Math.max(imgW * 0.6, fontSize * 10);
        const textLines = wrapText(ctx, text, textMaxWidth);
        const totalTextHeight = textLines.length * lineHeight;
        
        canvasW = imgW + textMaxWidth + padding * 3;
        canvasH = Math.max(imgH + padding * 2, totalTextHeight + padding * 2);

        canvas.width = canvasW; canvas.height = canvasH;

        // Draw Gradient Background
        const gradient = ctx.createLinearGradient(0, 0, 0, canvasH);
        gradient.addColorStop(0, color1);
        gradient.addColorStop(1, color2);
        ctx.fillStyle = gradient; 
        ctx.fillRect(0, 0, canvasW, canvasH);

        // Draw Image
        const finalImgY = (canvasH - imgH) / 2;
        ctx.drawImage(currentImage, padding, finalImgY, imgW, imgH);

        // Draw Text
        ctx.fillStyle = "#000000";
        ctx.font = `${fontSize}px -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif`;
        ctx.textAlign = align;
        ctx.textBaseline = "top";
        
        const startTextY = (canvasH - totalTextHeight) / 2;
        
        let textStartX = padding * 2 + imgW;
        let textX;
        if(align === "left") textX = textStartX;
        else if(align === "right") textX = textStartX + textMaxWidth;
        else textX = textStartX + textMaxWidth / 2; // center
        
        textLines.forEach((line, index) => {
          ctx.fillText(line, textX, startTextY + index * lineHeight);
        });
      }
    }

    // Text Wrapping Function
    function wrapText(context, text, maxWidth) {
      if (!text.trim()) return [];
      const lines = [];
      const chars = text.split('');
      let currentLine = '';

      for (let i = 0; i < chars.length; i++) {
        let testLine = currentLine + chars[i];
        let metrics = context.measureText(testLine);
        if (metrics.width > maxWidth && i > 0) {
          if (chars[i] === '\n') {
            lines.push(currentLine); currentLine = '';
          } else {
            lines.push(currentLine); currentLine = chars[i];
          }
        } else {
          if (chars[i] === '\n') {
             lines.push(currentLine); currentLine = '';
          } else {
             currentLine = testLine;
          }
        }
      }
      if (currentLine) lines.push(currentLine);
      return lines;
    }

    // Init
    drawPoster();

    // Copy Button Logic
    document.getElementById('copyBtn').addEventListener('click', () => {
      if (!currentImage) return alert("Please paste or upload an image first!");
      try {
        canvas.toBlob(async (blob) => {
          const item = new ClipboardItem({ "image/png": blob });
          await navigator.clipboard.write([item]);
          
          const btn = document.getElementById('copyBtn');
          btn.innerHTML = "✅ Copied!";
          setTimeout(() => btn.innerHTML = "📋 Copy Image", 2000);
        });
      } catch (err) {
        alert("Your browser doesn't support direct copy. Please use the Download button.");
      }
    });

    // Download Button Logic
    document.getElementById('downloadBtn').addEventListener('click', () => {
      if (!currentImage) return alert("Please paste or upload an image first!");
      const link = document.createElement('a');
      link.download = 'Poster_' + new Date().getTime() + '.png';
      link.href = canvas.toDataURL('image/png');
      link.click();
    });
  </script>
</body>
</html>
